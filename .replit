modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
AI_PRIMARY_MODEL = "gpt-5-nano"
AI_SECONDARY_MODEL = "gpt-5.4-mini"
STRIPE_PRICE_AUDIO_FIRST_MONTHLY = "price_1UIEKWEoxhUPFxginsVKLh4B"
STRIPE_PRICE_AUDIO_FIRST_QUARTERLY = "price_1UIEKYEoxhUPFxgillO64aru"
STRIPE_PRICE_AUDIO_FIRST_YEARLY = "price_1UIEKZEoxhUPFxgidV6KoGIQ"
STRIPE_PRICE_READ_WRITE_MONTHLY = "price_1UIEKSEoxhUPFxgiIfAGrHsL"
STRIPE_PRICE_READ_WRITE_QUARTERLY = "price_1UIEKUEoxhUPFxgi9jqSf4UJ"
STRIPE_PRICE_READ_WRITE_YEARLY = "price_1UIEKVEoxhUPFxgiMZ4SUvmH"
